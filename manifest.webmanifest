{
  "name": "SVGCraft",
  "short_name": "SVGCraft",
  "description": "A familiar-feeling SVG editor that runs in your browser.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#001e36",
  "theme_color": "#001e36",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [{ "action": "./", "accept": { "image/svg+xml": [".svg"] } }]
}
